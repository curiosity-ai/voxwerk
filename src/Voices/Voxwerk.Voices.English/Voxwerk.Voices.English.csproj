<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Voxwerk.Voices.English</PackageId>
    <RootNamespace>Voxwerk.Voices.English</RootNamespace>
    <Description>Catalog of ready-made English voices for Voxwerk: id, name, accent, style, description and VoiceDesign prompt of every voice. Speak them with the VoiceDesign model, or add the optional Voxwerk.Voices.English.* audio packages to clone them. Register with EnglishVoices.Register().</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Voxwerk\Voxwerk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Metadata of every English voice, generated by tools/Voxwerk.VoiceBuilder. -->
    <EmbeddedResource Include="Resources\voices.json" LogicalName="voices.json" />
  </ItemGroup>

</Project>
