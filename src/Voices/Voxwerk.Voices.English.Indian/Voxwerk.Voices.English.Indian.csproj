<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Voxwerk.Voices.English.Indian</PackageId>
    <RootNamespace>Voxwerk.Voices.English.Indian</RootNamespace>
    <Description>Reference audio for cloning English Voxwerk voices (metadata in Voxwerk.Voices.English): Indian English, including Hindi- and Tamil-influenced accents. Register with EnglishIndianVoices.Register().</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Voxwerk.Voices.English\Voxwerk.Voices.English.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ogg Opus reference samples, generated by tools/Voxwerk.VoiceBuilder. -->
    <EmbeddedResource Include="Resources\samples\*.opus" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
