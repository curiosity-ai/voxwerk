<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Voxwerk.Voices.English.Indian</PackageId>
    <RootNamespace>Voxwerk.Voices.English.Indian</RootNamespace>
    <Description>Ready-made Indian English voices for Voxwerk (Indian English, including Hindi- and Tamil-influenced accents.). Register with EnglishIndianVoices.Register().</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Voxwerk\Voxwerk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Voice metadata and Ogg Opus samples, generated by tools/Voxwerk.VoiceBuilder. -->
    <EmbeddedResource Include="Resources\voices.json" LogicalName="voices.json" />
    <EmbeddedResource Include="Resources\samples\*.opus" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
