<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Voxwerk.Voices.English.Asian</PackageId>
    <RootNamespace>Voxwerk.Voices.English.Asian</RootNamespace>
    <Description>Ready-made Asian English voices for Voxwerk (Southeast and East Asian Englishes: Filipino, Singaporean, Malaysian, Chinese, Japanese, Korean, Indonesian.). Register with EnglishAsianVoices.Register().</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Voxwerk\Voxwerk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Voice metadata and Ogg Opus samples, generated by tools/Voxwerk.VoiceBuilder. -->
    <EmbeddedResource Include="Resources\voices.json" LogicalName="voices.json" />
    <EmbeddedResource Include="Resources\samples\*.opus" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
