<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Voxwerk.Voices.English.American.Commercial</PackageId>
    <RootNamespace>Voxwerk.Voices.English.American.Commercial</RootNamespace>
    <Description>Reference audio for cloning English Voxwerk voices (metadata in Voxwerk.Voices.English): General American voices for commercials, radio, news, corporate and announcements. Register with EnglishAmericanCommercialVoices.Register().</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Voxwerk.Voices.English\Voxwerk.Voices.English.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ogg Opus reference samples, generated by tools/Voxwerk.VoiceBuilder. -->
    <EmbeddedResource Include="Resources\samples\*.opus" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
