<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Voxwerk.Voices.English.Irish</PackageId>
    <RootNamespace>Voxwerk.Voices.English.Irish</RootNamespace>
    <Description>Ready-made Irish English voices for Voxwerk (Irish English.). Register with EnglishIrishVoices.Register().</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Voxwerk\Voxwerk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Voice metadata and Ogg Opus samples, generated by tools/Voxwerk.VoiceBuilder. -->
    <EmbeddedResource Include="Resources\voices.json" LogicalName="voices.json" />
    <EmbeddedResource Include="Resources\samples\*.opus" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
