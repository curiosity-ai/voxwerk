<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Voxwerk.Voices.English.American.Regional</PackageId>
    <RootNamespace>Voxwerk.Voices.English.American.Regional</RootNamespace>
    <Description>Ready-made English voices for Voxwerk. Regional US accents: Southern, Midwest, Northeast, New York, Boston, Chicago and African American English. Register with EnglishAmericanRegionalVoices.Register().</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Voxwerk\Voxwerk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Voice metadata and Ogg Opus samples, generated by tools/Voxwerk.VoiceBuilder. -->
    <EmbeddedResource Include="Resources\voices.json" LogicalName="voices.json" />
    <EmbeddedResource Include="Resources\samples\*.opus" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
