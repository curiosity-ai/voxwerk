<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Voxwerk.Voices.English.European</PackageId>
    <RootNamespace>Voxwerk.Voices.English.European</RootNamespace>
    <Description>Reference audio for cloning English Voxwerk voices (metadata in Voxwerk.Voices.English): English with continental European accents. Register with EnglishEuropeanVoices.Register().</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Voxwerk.Voices.English\Voxwerk.Voices.English.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ogg Opus reference samples, generated by tools/Voxwerk.VoiceBuilder. -->
    <EmbeddedResource Include="Resources\samples\*.opus" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
