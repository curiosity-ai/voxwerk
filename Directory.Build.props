<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- NuGet metadata shared by every package (the version is stamped by CI: /p:Version=yy.M.<buildId>). -->
  <PropertyGroup>
    <Authors>Voxwerk contributors</Authors>
    <PackageProjectUrl>https://github.com/theolivenbaum/voxwerk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/theolivenbaum/voxwerk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>tts;text-to-speech;qwen3-tts;voice-cloning;speech;audio</PackageTags>
  </PropertyGroup>
</Project>
